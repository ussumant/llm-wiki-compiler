#!/usr/bin/env bash
# Shared context helper for llm-wiki-compiler.
# Prints wiki session guidance as plain text when .wiki-compiler.json is present.

set -euo pipefail

config_file=""
dir="${1:-$PWD}"
while [ "$dir" != "/" ]; do
  if [ -f "$dir/.wiki-compiler.json" ]; then
    config_file="$dir/.wiki-compiler.json"
    break
  fi
  dir="$(dirname "$dir")"
done

if [ -z "$config_file" ]; then
  exit 0
fi

project_root="$(dirname "$config_file")"

read_config() {
  local expr="$1"
  CONFIG_FILE="$config_file" node -e "const c=require(process.env.CONFIG_FILE); ${expr}" 2>/dev/null
}

output_path="$(read_config "console.log(c.output || '')")"
mode="$(read_config "console.log(c.mode || 'staging')")"
name="$(read_config "console.log(c.name || 'Project')")"
wiki_mode="$(read_config "console.log(c.mode === 'codebase' ? 'codebase' : 'knowledge')" || echo "knowledge")"

if [ -z "$output_path" ]; then
  exit 0
fi

index_file="$project_root/$output_path/INDEX.md"
state_file="$project_root/$output_path/.compile-state.json"

if [ ! -f "$index_file" ]; then
  printf '[Wiki Compiler] Wiki configured for "%s" but not yet compiled. In Claude, run /wiki-compile. In Codex, ask: "Compile changed sources into the wiki."\n' "$name"
  exit 0
fi

topic_count="$(STATE_FILE="$state_file" node -e "const s=require(process.env.STATE_FILE); console.log((s.topics||[]).length)" 2>/dev/null || echo "?")"
last_compiled="$(STATE_FILE="$state_file" node -e "const s=require(process.env.STATE_FILE); console.log(s.last_compiled || 'unknown')" 2>/dev/null || echo "unknown")"
auto_update="$(read_config "console.log(c.auto_update || 'off')" || echo "off")"

stale_warning=""
bookmark_count=0
if [ "$auto_update" = "prompt" ] && [ "$last_compiled" != "unknown" ]; then
  sources_json="$(read_config "(c.sources||[]).forEach(s => console.log(s.path))" || true)"
  changed_count=0
  while IFS= read -r src_path; do
    if [ -z "$src_path" ]; then
      continue
    fi
    if [[ "$src_path" == ~/* || "$src_path" == "~" ]]; then
      resolved_path="${src_path/#\~/$HOME}"
    else
      resolved_path="$project_root/$src_path"
    fi
    if [ -d "$resolved_path" ]; then
      ref_file="$(mktemp)"
      touch -t "$(echo "$last_compiled" | sed 's/-//g')0000" "$ref_file" 2>/dev/null || true
      if [ "$wiki_mode" = "codebase" ]; then
        count="$(find "$resolved_path" \
          \( -name "README.md" -o -name "CLAUDE.md" -o -name "AGENTS.md" -o -name "ARCHITECTURE.md" \
             -o -name "CONTRIBUTING.md" -o -name "CHANGELOG.md" \
             -o -name "*.proto" -o -name "*.graphql" \
             -o -name "openapi.yaml" -o -name "openapi.json" \
             -o -name "ADR-*.md" \
             -o -name "docker-compose.yml" -o -name "Dockerfile" \
             -o -name ".env.example" \
             -o -name "package.json" -o -name "go.mod" -o -name "Cargo.toml" -o -name "pyproject.toml" \) \
          -not -path "*/node_modules/*" -not -path "*/.git/*" -not -path "*/dist/*" \
          -not -path "*/vendor/*" -not -path "*/__pycache__/*" -not -path "*/.build/*" \
          -newer "$ref_file" 2>/dev/null | wc -l | tr -d ' ')"
      else
        count="$(find "$resolved_path" -name "*.md" -newer "$ref_file" 2>/dev/null | wc -l | tr -d ' ')"
      fi
      changed_count=$((changed_count + count))
      if [[ "$src_path" == *ft-bookmarks* || "$src_path" == *bookmarks/* ]]; then
        bookmark_count=$((bookmark_count + count))
      fi
      rm -f "$ref_file"
    fi
  done <<< "$sources_json"

  if [ "$changed_count" -gt 0 ]; then
    if [ "$bookmark_count" -gt 0 ] && [ "$bookmark_count" -eq "$changed_count" ]; then
      stale_warning="\n\n$bookmark_count new bookmark(s) since last compile ($last_compiled). Compile the wiki to fold them into topics."
    elif [ "$bookmark_count" -gt 0 ]; then
      other=$((changed_count - bookmark_count))
      stale_warning="\n\nWiki may be stale: $bookmark_count new bookmark(s) + $other other file(s) changed since last compile ($last_compiled). Compile the wiki to update."
    else
      stale_warning="\n\nWiki may be stale: $changed_count files changed since last compile ($last_compiled). Compile the wiki to update."
    fi
  fi
fi

case "$mode" in
  staging)
    context="[Wiki Compiler] A compiled knowledge wiki is available for \"$name\".\nLocation: $output_path\nTopics: $topic_count | Last compiled: $last_compiled\nMode: staging (supplements existing context)\n\nWhen you need deep context on a topic, read ${output_path}INDEX.md to see available topics, then read specific topic articles. This wiki synthesizes source files into topic-based briefings; reading one topic article replaces reading 10-20 raw files.\n\nWiki articles are read-only synthesis. Never modify wiki/ files directly; they are regenerated by the compile workflow.${stale_warning}"
    ;;
  recommended)
    context="[Wiki Compiler] \"$name\" knowledge wiki active.\nLocation: $output_path\nTopics: $topic_count | Last compiled: $last_compiled\nMode: recommended\n\nFor project context, start with ${output_path}INDEX.md. Read topic articles before reading raw source files. Fall back to raw sources only when the wiki article is insufficient or you need granular detail.\n\nWiki articles are read-only synthesis; they are regenerated by the compile workflow.${stale_warning}"
    ;;
  primary)
    context="[Wiki Compiler] \"$name\" wiki is the primary knowledge source.\nLocation: $output_path\nTopics: $topic_count | Last compiled: $last_compiled\n\nRead ${output_path}INDEX.md at session start. Only read raw source files when a wiki article's Sources section points you there for detail.\n\nWiki articles are read-only synthesis; they are regenerated by the compile workflow.${stale_warning}"
    ;;
  *)
    context="[Wiki Compiler] Wiki available for \"$name\" at $output_path ($topic_count topics, last compiled: $last_compiled). Compile the wiki to update.${stale_warning}"
    ;;
esac

printf '%b\n' "$context"
